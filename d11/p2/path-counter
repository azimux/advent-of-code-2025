class NetworkPath
  attr_accessor :value, :list

  def initialize(value, list = nil)
    self.value = value
    self.list = list
  end

  def hash
    # rubocop:disable Security/CompoundHash
    value.hash + list.hash
    # rubocop:enable Security/CompoundHash
  end

  def ==(other)
    other.class == self.class && other.value == value && other.list == list
  end

  def eql?(other) = self == other
end

class Network
  attr_accessor :graph, :start_at, :seen

  def initialize(inputs_file, start_at)
    self.start_at = start_at

    inputs = File.read(inputs_file)

    lines = inputs.split("\n")

    self.graph = {}

    lines.each do |line|
      if line =~ /(\w+):(.*)/
        source = $1
        destination = $2.scan(/\w+/)

        graph[source.to_sym] = destination.map(&:to_sym)
      else
        raise "Unexpected line #{line}"
      end
    end
  end

  def answer
    self.seen = Set.new
    path_count_from(start_at, seen_fft: false, seen_dac: false, path: nil)
  end

  private

  def path_count_from(node, seen_fft:, seen_dac:, path:)
    path = NetworkPath.new(node, path)

    return 0 if seen.include?(path)

    seen << path

    case node
    when :fft
      seen_fft = true
    when :dac
      seen_dac = true
    end

    destinations = graph[node]

    destinations.map do |destination|
      if destination == :out
        seen_fft && seen_dac ? 1 : 0
      else
        path_count_from(destination, seen_fft:, seen_dac:, path:)
      end
    end.sum
  end
end

network = Network.new(inputs_file, :svr)
puts network.answer
