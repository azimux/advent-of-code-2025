# take:
#
# start -> fft
# fft -> dac
# dac -> out
#
# Multiple those together, call this "fft_first_path"
#
# then, take
#
# start -> dac
# dac -> fft
# fft -> out
#
# multiple these together and add it to fft_first_path.
fft_first_path_count = [
  [:svr, :fft, :dac],
  [:fft, :dac, :svr],
  [:dac, :out, [:svr, :fft]]
].map do |(start_at, end_at, exclude)|
  NetworkPathCounter.new(
    network,
    start_at:,
    end_at:,
    exclude:,
    wait_on_cache:
  ).answer
end.inject(:*)

dac_first_path_count = [
  [:svr, :dac, :fft],
  [:dac, :fft, :svr],
  [:fft, :out, [:svr, :dac]]
].map do |(start_at, end_at, exclude)|
  NetworkPathCounter.new(
    network,
    start_at:,
    end_at:,
    exclude:,
    wait_on_cache:
  ).answer
end.inject(:*)

puts dac_first_path_count + fft_first_path_count
