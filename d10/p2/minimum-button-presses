machines = MachineParser.parse("inputs_attempt_splitting_machines_by_button_groups_index_from_min_buttons.txt")

Machine.load_cache_from_file

machines.sort_by!(&:crude_max_pushes)

pushes = machines.map do |machine|
  puts "#{Time.now}: starting new machine..."
  push_count = machine.minimum_pushes_required

  if push_count.nil?
    puts "nil push count wtf!!"
    puts machine
    binding.pry
  end

  push_count
end

sum = pushes.sum

puts "found sum! #{sum}"

Machine.close_cache_file

