inputs_file = "min_joltage_biggest_button.txt"
puts "running for #{inputs_file}"
machines = MachineParser.parse(inputs_file)

Machine.load_cache_from_file

machines.sort_by!(&:crude_max_pushes)

# caps = {}

require "yaml"
caps = YAML.load_file("caps.yml")

pushes = machines.map do |machine|
  puts "#{Time.now}: starting new machine..."
  push_count = machine.minimum_pushes_required

  if push_count.nil?
    puts "nil push count wtf!!"
    puts machine
    binding.pry
  end

  puts "solution for:"
  puts machine.to_s_parsable
  puts push_count
  puts

  caps_key = machine.to_s_parsable
  if caps[caps_key] > push_count
    caps[caps_key] = push_count

    File.write("caps.yml", YAML.dump(caps))
  end

  push_count
end

# require "yaml"
