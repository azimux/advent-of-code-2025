#!/usr/bin/env ruby

require "yaml"

# require "pry"
# require "pry-byebug"

require_relative "minimum_pushes_cache"
require_relative "machine_parser"

MinimumPushesCache.cache_file_name = "inputs.cache"
Caps.caps_file = "caps.yml"

inputs_file = "inputs.txt"

puts "running for #{inputs_file} #{MinimumPushesCache.cache_file_name}"
machines = MachineParser.parse(inputs_file)

MinimumPushesCache.load_cache_from_file

machines.sort_by!(&:crude_max_pushes)

pushes = machines.map do |machine|
  puts "#{Time.now}: starting new machine..."
  push_count = machine.minimum_pushes_required

  if push_count.nil?
    puts "nil push count wtf!!"
    puts machine
    binding.pry
  end

  puts "solution for:"
  puts machine.to_s_parsable
  puts push_count
  puts

  Caps.update_cap_if_needed(machine, push_count)

  push_count
end

sum = pushes.sum

puts "found sum! #{sum}"

MinimumPushesCache.close_cache_file

