#!/usr/bin/env ruby

# require "pry"
# require "pry-byebug"

require_relative "machine_parser"

Machine.cache_file_name = "two_key.cache"

inputs_file = "inputs.txt"

puts "running for #{inputs_file} #{Machine.cache_file_name}"
machines = MachineParser.parse(inputs_file)

Machine.load_cache_from_file

machines.sort_by!(&:crude_max_pushes)

# caps = {}

require "yaml"
caps = YAML.load_file("caps.yml")

pushes = machines.map do |machine|
  puts "#{Time.now}: starting new machine..."
  push_count = machine.minimum_pushes_required

  if push_count.nil?
    puts "nil push count wtf!!"
    puts machine
    binding.pry
  end

  puts "solution for:"
  puts machine.to_s_parsable
  puts push_count
  puts

  caps_key = machine.to_s_parsable
  cap = caps[caps_key]
  if cap.nil? || cap > push_count
    caps[caps_key] = push_count

    File.write("caps.yml", YAML.dump(caps))
  elsif push_count > cap
    puts "unexpected worse push_count: #{push_count} > #{cap} for: #{caps_key}"
    # binding.pry
    # raise "wtf how can we have a solution above the cap???"
  end

  push_count
end

# require "yaml"
# File.write("caps.yml", YAML.dump(caps))

sum = pushes.sum

puts "found sum! #{sum}"

Machine.close_cache_file

